{
  "name": "tomisakae-vn-rp-plugin",
  "version": "2.2.2",
  "description": "Vietnamese-first RisuAI roleplay plugin for Freaky Frankenstein 5.4 and Sola V2 Flame.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsx scripts/build-tomisakae-vn-rp-plugin.ts",
    "build:check": "tsx scripts/build-tomisakae-vn-rp-plugin.ts --check",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:ff54": "tsx scripts/build-ff54-vietnamese-comparison.ts",
    "review:sola": "tsx scripts/build-preset-vietnamese-review.ts",
    "review:sola:changes": "tsx scripts/build-sola-raw-review.ts",
    "review:sola:full": "tsx scripts/build-sola-raw-review.ts --full",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm format:check && pnpm check && pnpm build && pnpm test && pnpm build:check"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "commander": "^14.0.2",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.13"
  }
}
